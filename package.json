{
  "name": "collab",
  "version": "1.3.1",
  "description": "Cross-platform video conferencing built with React Native, Expo, WebRTC, and a Node.js signaling server.",
  "license": "MIT",
  "author": "Alex Alghisi",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "desktop:web": "node scripts/prepare-desktop.mjs",
    "server": "tsx watch server/src/index.ts",
    "server:start": "tsx server/src/index.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/openai": "^4.0.66",
    "@expo/vector-icons": "^15.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "ai": "^7.0.99",
    "babel-preset-expo": "~54.0.10",
    "cors": "^2.8.6",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.11",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "multer": "^2.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "^124.0.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@eslint/js": "^10.0.1",
    "@expo/metro-runtime": "~6.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/react": "~19.1.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
