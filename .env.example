# Collab environment variables.
# Copy this file to `.env` (git-ignored) and fill in only what you need.
# Everything here is optional: with nothing set, the app runs as an open guest
# lobby and connects to a local signaling server.

# --- Signaling server ---
# URL of the Socket.IO signaling server the client connects to.
EXPO_PUBLIC_SIGNALING_URL=http://localhost:4000

# --- Social sign-in: Web (Firebase) ---
# Firebase console > Project settings > Your apps > Web app SDK config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Social sign-in: Mobile (Expo AuthSession) ---
# Google OAuth client IDs from Google Cloud Console > APIs & Services >
# Credentials. Create one OAuth 2.0 client per platform (Web, iOS, Android).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Facebook app ID from Facebook for Developers > your app > Settings > Basic.
EXPO_PUBLIC_FACEBOOK_APP_ID=
