# Collab environment variables.
# Copy this file to `.env` (git-ignored) and fill in only what you need.
# Everything here is optional: with nothing set, the server keeps its accounts
# and meetings in `server/.data/` and the client talks to a local signaling
# server.

# --- Signaling server ---
# URL of the Socket.IO signaling server the client connects to. It also serves
# the account database the app signs in against.
EXPO_PUBLIC_SIGNALING_URL=http://localhost:4000

# --- Local database ---
# Where the server keeps accounts.json and meetings.json. Defaults to
# `server/.data`; point it at a mounted volume when running in a container.
# DATA_DIR=/var/lib/collab

# --- Web backend (Firebase) ---
# Optional. Enables serverless signaling through Firestore and team chat
# channels (no signaling server needed on web). Sign-in stays local either way,
# so the client takes an anonymous Firebase session to satisfy the rules —
# enable Anonymous sign-in under Authentication > Sign-in method, and publish
# firestore.rules in the console.
# Firebase console > Project settings > Your apps > Web app SDK config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Meeting search index ---
# Where past-meeting passages are stored. memory (default) keeps them in
# process; postgres needs DATABASE_URL and the pgvector extension; pinecone
# needs PINECONE_API_KEY and PINECONE_INDEX. OPENAI_API_KEY switches the
# embedder from the local hash to text-embedding-3-small.
# VECTOR_STORE=memory
# DATABASE_URL=
# PINECONE_API_KEY=
# PINECONE_INDEX=
# OPENAI_API_KEY=
# ASSISTANT_PROVIDER=openai
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Meeting invites (SMS / email) ---
# The signaling server delivers these. Without them, Send invite reports that
# SMS or email is not configured. PUBLIC_APP_URL is the join link put in the
# message (use the GitHub Pages or tunneled origin, not localhost).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=
# RESEND_API_KEY=
# RESEND_FROM=Collab <invites@your-domain>
# PUBLIC_APP_URL=https://your-app.example
# EXPO_PUBLIC_APP_URL=https://your-app.example
