# Collab environment variables.
# Copy this file to `.env` (git-ignored) and fill in only what you need.
# Nothing here is required to sign up and meet locally: the app talks to a
# local signaling server, which keeps the accounts in its own database.

# --- Signaling server ---
# URL of the Socket.IO signaling server the client connects to.
EXPO_PUBLIC_SIGNALING_URL=http://localhost:4000

# --- Accounts (local database) ---
# Where the server keeps names, addresses, password verifiers and sessions.
# Defaults to server/data/accounts.json (git-ignored).
# ACCOUNTS_DB_PATH=server/data/accounts.json
# Only needed when sign-in is served from somewhere other than the signaling
# URL above — including a Firestore deployment, which has no signaling URL.
# EXPO_PUBLIC_ACCOUNTS_URL=http://localhost:4000

# --- Web backend (Firebase) ---
# Enables serverless signaling through Firestore (no signaling server needed
# for the call itself) plus team chat and per-user meeting storage. Publish
# firestore.rules in the console.
# Firebase console > Project settings > Your apps > Web app SDK config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Meeting search index ---
# Where past-meeting passages are stored. memory (default) keeps them in
# process; postgres needs DATABASE_URL and the pgvector extension; pinecone
# needs PINECONE_API_KEY and PINECONE_INDEX. OPENAI_API_KEY switches the
# embedder from the local hash to text-embedding-3-small.
# VECTOR_STORE=memory
# DATABASE_URL=
# PINECONE_API_KEY=
# PINECONE_INDEX=
# OPENAI_API_KEY=
# ASSISTANT_PROVIDER=openai
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Meeting invites (SMS / email) ---
# The signaling server delivers these. Without them, Send invite reports that
# SMS or email is not configured. PUBLIC_APP_URL is the join link put in the
# message (use the GitHub Pages or tunneled origin, not localhost).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=
# RESEND_API_KEY=
# RESEND_FROM=Collab <invites@your-domain>
# PUBLIC_APP_URL=https://your-app.example
# EXPO_PUBLIC_APP_URL=https://your-app.example
