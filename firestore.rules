rules_version = '2';

// Deploy from Firebase console > Firestore Database > Rules (or `firebase deploy --only firestore:rules`).
// Sign-in happens against the server's own account database, so clients hold an
// anonymous Firebase session: these rules keep the public out, not each other.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Team chat channels are shared by every signed-in user of this deployment.
    match /channels/{channelId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Scheduled meetings and history are private to their owner.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
